{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "snoopyjmX Cyberpunk Design Tokens",
  "version": "1.0.0",
  "typography": {
    "fontFamily": "'JetBrains Mono', 'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', monospace",
    "fontSizes": {
      "xs": 11,
      "sm": 12,
      "base": 14,
      "md": 15,
      "lg": 18,
      "xl": 22,
      "xxl": 28
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    }
  },
  "radii": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "xl": 16
  },
  "themes": {
    "dark": {
      "name": "dark",
      "bg": "#0a0e14",
      "surface": "#0d1117",
      "surfaceSubtle": "#161b22",
      "border": "#30363d",
      "borderSubtle": "#21262d",
      "text": "#e6edf3",
      "textSecondary": "#8b949e",
      "textTertiary": "#6e7681",
      "accentPrimary": "#00e5ff",
      "accentPrimarySubtle": "rgba(0, 229, 255, 0.12)",
      "accentPrimaryGlow": "rgba(0, 229, 255, 0.25)",
      "accentSecondary": "#7c5cff",
      "accentSecondarySubtle": "rgba(124, 92, 255, 0.12)",
      "accentSecondaryGlow": "rgba(124, 92, 255, 0.22)",
      "success": "#3fb950",
      "successSubtle": "rgba(63, 185, 80, 0.15)",
      "grid": "rgba(110, 118, 129, 0.06)",
      "radialGlow": "radial-gradient(circle at 80% 20%, rgba(124, 92, 255, 0.08) 0%, rgba(10, 14, 20, 0) 70%)"
    },
    "light": {
      "name": "light",
      "bg": "#f6f8fa",
      "surface": "#ffffff",
      "surfaceSubtle": "#eaeef2",
      "border": "#d0d7de",
      "borderSubtle": "#e1e4e8",
      "text": "#1f2328",
      "textSecondary": "#57606a",
      "textTertiary": "#6e7781",
      "accentPrimary": "#007799",
      "accentPrimarySubtle": "rgba(0, 119, 153, 0.10)",
      "accentPrimaryGlow": "rgba(0, 119, 153, 0.20)",
      "accentSecondary": "#6544d6",
      "accentSecondarySubtle": "rgba(101, 68, 214, 0.10)",
      "accentSecondaryGlow": "rgba(101, 68, 214, 0.18)",
      "success": "#1a7f37",
      "successSubtle": "rgba(26, 127, 55, 0.12)",
      "grid": "rgba(87, 96, 106, 0.06)",
      "radialGlow": "radial-gradient(circle at 80% 20%, rgba(101, 68, 214, 0.05) 0%, rgba(246, 248, 250, 0) 70%)"
    }
  },
  "animation": {
    "durations": {
      "pulse": "4s",
      "sweep": "6s",
      "glitch": "8s",
      "blink": "1s",
      "draw": "2.5s"
    }
  }
}
